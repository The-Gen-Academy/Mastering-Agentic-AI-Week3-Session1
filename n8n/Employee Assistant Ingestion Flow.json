      },
      "id": "83bf0803-6d4d-4d21-90ca-bce45e6cab30",
      "name": "On form submission",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        2832,
        2400
      ],
      "webhookId": "60c6ea6b-b6d9-4e0e-b045-5cc7368d2a0a"
    },
    {
      "parameters": {
        "jsCode": "// One output item per uploaded file, tagged with a category derived from the\n// file name. Replaces the hard-coded POLICIES dict from the notebook.\n//\n//   meals.md              -> category \"meals\"\n//   Travel_Policy_v3.pdf  -> category \"travel\"\n//   parking.docx          -> category \"parking\"   (no keyword match -> slug of the name)\n\nconst KNOWN_CATEGORIES = ['meals', 'travel', 'equipment'];\n\n// Extensions the Default Data Loader reads as plain text. Browsers often send\n// .md as application/octet-stream, which the \"auto\" loader cannot dispatch, so\n// we normalise the mime type here.\nconst TEXT_EXTENSIONS = ['md', 'markdown', 'txt', 'text', 'rst'];\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const binary = item.binary ?? {};\n\n  for (const key of Object.keys(binary)) {\n    const bin = binary[key];\n    const fileName = bin.fileName ?? key;\n\n    const stem = fileName.replace(/\\.[^.]+$/, '');\n    const ext = (fileName.split('.').pop() ?? '').toLowerCase();\n    const slug = stem\n      .toLowerCase()\n      .replace(/[^a-z0-9]+/g, '_')\n      .replace(/^_+|_+$/g, '');\n\n    const matched = KNOWN_CATEGORIES.find((c) => slug.includes(c));\n\n    const normalised =\n      TEXT_EXTENSIONS.includes(ext) && !String(bin.mimeType ?? '').startsWith('text/')\n        ? { ...bin, mimeType: 'text/plain' }\n        : bin;\n\n    out.push({\n      json: {\n        file_name: fileName,\n        category: matched ?? (slug || 'other'),\n        matched_known_category: Boolean(matched),\n        form_field: key,\n        submitted_at: item.json.submittedAt ?? null,\n      },\n      binary: { data: normalised },\n    });\n  }\n}\n\nif (out.length === 0) {\n  throw new Error(\n    'No file found on the form submission. Attach at least one document and submit again.'\n  );\n}\n\nreturn out;\n"
      },
